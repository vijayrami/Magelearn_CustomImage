<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magelearn\CustomImage\ViewModel\CategoryImage $viewModel */

$viewModel = $block->getViewModel();
$category = $viewModel->getCategory();

if (!$category) {
    return;
}

$imageCode = (string) $block->getData('image_code');
$imageUrl = $viewModel->getImageUrl($imageCode);
$cssClass = (string) $block->getData('css_class');

if (!$imageUrl) {
    return;
}

$categoryName = $block->escapeHtml($category->getName());
?>

<div class="<?= $block->escapeHtmlAttr($cssClass) ?>">
    <img
        src="<?= $block->escapeUrl($imageUrl) ?>"
        alt="<?= $categoryName ?>"
        title="<?= $categoryName ?>"
    />
</div>